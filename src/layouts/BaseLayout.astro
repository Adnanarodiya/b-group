---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bi Group | Building better, together',
  description = 'Bi Group brings expertise, innovation and care to every industry we serve.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#062f78" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
