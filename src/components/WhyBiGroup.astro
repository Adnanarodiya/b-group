---
const reasons = [
  {
    title: "Industrial credibility",
    text: "Coatings and engineering DNA trusted by defence, steel, and infrastructure leaders.",
  },
  {
    title: "Diversified strength",
    text: "A multi-vertical model that connects factories, projects, homes, and digital commerce.",
  },
  {
    title: "Quality without compromise",
    text: "Performance-first products and processes designed for India’s toughest operating conditions.",
  },
  {
    title: "Partnership mindset",
    text: "Long-term relationships built on responsiveness, clarity, and delivery you can measure.",
  },
];
---

<section class="why section" id="why">
  <div class="container">
    <div class="intro reveal">
      <p class="section-label">Why Bi Group</p>
      <h2 class="section-title">Built for trust. Scaled for growth.</h2>
      <p class="section-lead">
        Whether you are specifying protective coatings or exploring our consumer
        verticals, BiGROUP is structured to deliver consistency at every touchpoint.
      </p>
    </div>

    <div class="reason-grid">
      {
        reasons.map((reason, index) => (
          <article class={`reason reveal reveal-delay-${(index % 3) + 1}`}>
            <span class="num">0{index + 1}</span>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    background:
      radial-gradient(circle at 0% 100%, rgba(0, 45, 136, 0.08), transparent 35%),
      var(--mist);
  }

  .intro {
    margin-bottom: 2.5rem;
  }

  .reason-grid {
    display: grid;
    gap: 1.25rem;
  }

  .reason {
    padding: 1.5rem 0 1.35rem;
    border-top: 1px solid var(--line);
  }

  .num {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--gold-deep);
    margin-bottom: 0.7rem;
  }

  h3 {
    font-size: 1.3rem;
    margin-bottom: 0.55rem;
    color: var(--blue-deep);
  }

  p {
    color: var(--ink-soft);
    max-width: 36ch;
  }

  @media (min-width: 900px) {
    .reason-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }

    .reason {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 1.35rem;
    }

    .reason:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
