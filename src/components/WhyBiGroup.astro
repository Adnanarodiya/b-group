---
import Icon from "./Icon.astro";
import { reasons } from "../data/site";
---

<section id="why-bi-group" class="relative isolate overflow-hidden bg-navy-900 py-24 text-white lg:py-32">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(100%_100%_at_0%_0%,#102668_0%,#071335_55%,#040b21_100%)]"></div>
  <div
    class="absolute -right-40 bottom-0 -z-10 size-[34rem] rounded-full bg-navy-500/25 blur-[130px] animate-float-slow"
  >
  </div>
  <div class="grain -z-10"></div>

  <div class="container-page relative">
    <div class="max-w-2xl">
      <p class="eyebrow text-signal-500" data-reveal>Why Bi Group</p>
      <h2
        class="mt-5 text-[clamp(2rem,4.2vw,3.25rem)] leading-[1.05] font-extrabold"
        data-reveal
        style="--reveal-delay:60ms"
      >
        Six reasons customers keep coming back.
      </h2>
      <p class="mt-6 text-base leading-relaxed text-white/65 lg:text-lg" data-reveal style="--reveal-delay:120ms">
        Breadth is only useful if the quality holds at every point of contact. This is how we make
        sure it does.
      </p>
    </div>

    <ul class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-white/12 bg-white/12 md:grid-cols-2 lg:grid-cols-3">
      {
        reasons.map((reason, index) => (
          <li
            class="reason group relative bg-navy-900/85 p-7 transition-colors duration-500 hover:bg-navy-800 lg:p-8"
            data-reveal
            style={`--reveal-delay:${Math.min(index, 5) * 80}ms`}
          >
            <span class="flex size-12 items-center justify-center rounded-xl bg-white/8 text-signal-500 transition-all duration-500 group-hover:bg-signal-500 group-hover:text-navy-900">
              <Icon name={reason.icon as any} class="size-6" strokeWidth={1.7} />
            </span>
            <h3 class="mt-6 font-display text-lg leading-snug font-bold">{reason.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/60">{reason.text}</p>
            <span class="mt-6 block font-display text-xs font-bold tracking-[0.18em] text-white/25">
              {String(index + 1).padStart(2, "0")}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
