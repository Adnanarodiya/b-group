---
const verticals = [
  {
    name: "Bi Paints & Color Coating",
    blurb: "Industrial and decorative paints, powder coating and color systems engineered for extreme Indian conditions.",
    flagship: true,
    icon: `<path d="M4 4h13a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H8" /><path d="M4 4v7" /><path d="M19 7h2v4l-8 3v2" /><rect x="11" y="16" width="4" height="5" rx="1" />`,
  },
  {
    name: "Bi Modular Kitchen",
    blurb: "Precision-built modular kitchens that pair European design language with Indian cooking realities.",
    icon: `<rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 12h18" /><path d="M9 8h6" /><path d="M9 16h2" />`,
  },
  {
    name: "Bi Agriculture",
    blurb: "Farm inputs, agri-technology and produce programs supporting the people who feed the nation.",
    icon: `<path d="M12 21c0-6 3-10 9-11-1 6-4 10-9 11Z" /><path d="M12 21c0-6-3-10-9-11 1 6 4 10 9 11Z" /><path d="M12 21V9" /><path d="M12 9c0-3 1.5-5 4-6-.5 3-2 5-4 6Z" />`,
  },
  {
    name: "Bi Homeopathy",
    blurb: "Gentle, trusted homeopathic remedies and wellness care rooted in a century-old tradition of healing.",
    icon: `<path d="M8 3h8" /><path d="M10 3v5L4.5 17.5A3 3 0 0 0 7.2 22h9.6a3 3 0 0 0 2.7-4.5L14 8V3" /><path d="M7 15h10" />`,
  },
  {
    name: "Bi Clothes",
    blurb: "Everyday apparel made from quality fabrics — designed to look sharp and last long.",
    icon: `<path d="M9 4 12 6l3-2 6 4-2.5 3.5L16 10v10H8V10l-2.5 1.5L3 8l6-4Z" />`,
  },
  {
    name: "Bi Electronics",
    blurb: "Reliable consumer electronics and appliances that bring smart living within everyone's reach.",
    icon: `<rect x="3" y="5" width="18" height="12" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" />`,
  },
  {
    name: "Bi Air Conditioner",
    blurb: "Energy-efficient cooling engineered for Indian summers, from homes to commercial spaces.",
    icon: `<path d="M12 3v18" /><path d="M3 12h18" /><path d="m5.5 5.5 13 13" /><path d="m18.5 5.5-13 13" /><circle cx="12" cy="12" r="2.5" />`,
  },
  {
    name: "Bi Painting Solutions",
    blurb: "End-to-end professional painting services — surface prep, application and finish warranties.",
    icon: `<path d="M18 3a3 3 0 0 1 3 3c0 6-6 4-8 6l-8 8-3-3 8-8c2-2 0-6 6-6" /><path d="m14 7 3 3" />`,
  },
  {
    name: "Bi Engineering",
    blurb: "Fabrication, machining and engineering services for infrastructure and heavy industry.",
    icon: `<circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" />`,
  },
  {
    name: "Bi E-Commerce",
    blurb: "The digital storefront for every Bi brand — bringing the whole group to your doorstep.",
    icon: `<circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 8H6" />`,
  },
];
---

<section class="verticals section" id="businesses">
  <div class="container">
    <div class="verticals__head">
      <div>
        <p class="eyebrow" data-reveal>Our Business Verticals</p>
        <h2 class="section-title" data-reveal style="--reveal-delay: 80ms">
          Ten businesses. One standard.
        </h2>
      </div>
      <p class="section-lede verticals__lede" data-reveal style="--reveal-delay: 160ms">
        Each Bi Group vertical operates with its own focus and expertise,
        while drawing on the group's shared manufacturing strength, supply
        chain and obsession with quality.
      </p>
    </div>

    <div class="verticals__grid">
      {verticals.map((vertical, i) => (
        <article
          class:list={["card", { "card--flagship": vertical.flagship }]}
          data-reveal
          style={`--reveal-delay: ${(i % 5) * 70}ms`}
        >
          {vertical.flagship && <span class="card__badge">Flagship</span>}
          <span class="card__icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={vertical.icon}
            />
          </span>
          <h3 class="card__name">{vertical.name}</h3>
          <p class="card__blurb">{vertical.blurb}</p>
          <span class="card__link">
            Learn more
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .verticals {
    background: var(--paper-soft);
  }

  .verticals__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 3.2rem;
  }

  .verticals__lede {
    max-width: 44ch;
  }

  .verticals__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.4rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.9rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
  }

  .card::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--navy-600), var(--yellow-500));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
  }

  .card:hover::before {
    transform: scaleX(1);
  }

  .card--flagship {
    background: linear-gradient(150deg, var(--navy-800), var(--navy-600));
    border-color: transparent;
    color: #fff;
  }

  .card__badge {
    position: absolute;
    top: 1.3rem;
    right: 1.3rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--yellow-500);
    color: var(--navy-900);
  }

  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: rgba(27, 61, 158, 0.08);
    color: var(--navy-600);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .card:hover .card__icon {
    background: var(--navy-700);
    color: var(--yellow-500);
  }

  .card--flagship .card__icon {
    background: rgba(255, 255, 255, 0.12);
    color: var(--yellow-500);
  }

  .card__name {
    margin-top: 1.35rem;
    font-size: 1.18rem;
    font-weight: 800;
    color: var(--navy-800);
  }

  .card--flagship .card__name {
    color: #fff;
  }

  .card__blurb {
    margin-top: 0.6rem;
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--ink-soft);
    flex-grow: 1;
  }

  .card--flagship .card__blurb {
    color: rgba(255, 255, 255, 0.78);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--navy-600);
  }

  .card--flagship .card__link {
    color: var(--yellow-500);
  }

  .card__link svg {
    transition: transform 0.25s ease;
  }

  .card:hover .card__link svg {
    transform: translateX(4px);
  }

  @media (max-width: 820px) {
    .verticals__head {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 2.4rem;
    }
  }
</style>
