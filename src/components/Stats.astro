---
const stats = [
  { value: "10+", label: "Business verticals" },
  { value: "11+", label: "Enterprise clients highlighted" },
  { value: "₹500 Cr", label: "Paints investment announced" },
  { value: "Pan-India", label: "Ambition across industries" },
];
---

<section class="section pt-8" aria-label="At a glance">
  <div class="container">
    <div class="reveal grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        stats.map((stat) => (
          <article class="bg-light rounded-3xl p-7 card-shadow">
            <p class="text-3xl md:text-4xl font-semibold text-primary tracking-tight">
              {stat.value}
            </p>
            <p class="mt-2 text-text-dark">{stat.label}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
