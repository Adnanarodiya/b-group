---
const stats = [
  { value: 10, suffix: "", label: "Business verticals" },
  { value: 11, suffix: "+", label: "Enterprise clients" },
  { value: 500, suffix: "+", label: "Products & SKUs" },
  { value: 28, suffix: "", label: "States served across India" },
];
---

<section class="stats" id="stats">
  <div class="container">
    <div class="stats__strip" data-reveal>
      <p class="stats__caption">Bi Group at a glance</p>
      <div class="stats__grid">
        {stats.map((stat) => (
          <div class="stat">
            <span class="stat__value">
              <span class="stat__number" data-count={stat.value}>0</span>{stat.suffix}
            </span>
            <span class="stat__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .stats {
    padding-block: 0;
    position: relative;
    z-index: 2;
  }

  .stats__strip {
    background: linear-gradient(120deg, var(--navy-800), var(--navy-600));
    border-radius: var(--radius-lg);
    padding: clamp(2.2rem, 4.5vw, 3.5rem) clamp(1.8rem, 4.5vw, 4rem);
    color: #fff;
    box-shadow: 0 32px 64px -24px rgba(11, 29, 77, 0.45);
    transform: translateY(-50%);
    margin-bottom: calc(var(--section-pad) * -0.5);
  }

  .stats__caption {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--yellow-400);
    margin-bottom: 1.6rem;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .stat__value {
    display: block;
    font-size: clamp(2.1rem, 4vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .stat__label {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 820px) {
    .stats__strip {
      transform: none;
      margin-block: 3rem;
    }

    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // Count-up animation once the strip scrolls into view
  const numbers = document.querySelectorAll<HTMLElement>(".stat__number");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.count ?? 0);
    if (reduceMotion) {
      el.textContent = String(target);
      return;
    }
    const duration = 1600;
    const start = performance.now();
    const tick = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(target * eased));
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const counter = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          counter.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.5 }
  );
  numbers.forEach((el) => counter.observe(el));
</script>
