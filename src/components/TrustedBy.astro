---
const clients = [
  "AM/NS India",
  "Larsen & Toubro",
  "Godrej & Boyce",
  "Ministry of Defence",
  "Chowgule Group",
  "ElectroMech",
  "UNP Polyvalves",
  "Lohr India",
  "Marini Fayat Group",
  "Laxmipati Engineering",
  "NAFTech",
];
---

<section class="py-24 bg-bi-gray border-y border-bi-gray-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <div class="gold-accent mx-auto">
        <span class="text-bi-gold font-semibold text-sm uppercase tracking-widest">Our Partners</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-bi-navy mb-4">
        Trusted By <span class="italic">Industry Leaders</span>
      </h2>
      <p class="text-lg text-bi-navy/60 max-w-2xl mx-auto">
        Proud to partner with India's most respected organizations across defence, infrastructure, manufacturing, and beyond.
      </p>
    </div>
  </div>

  <!-- Marquee -->
  <div class="relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-bi-gray to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-bi-gray to-transparent z-10"></div>

    <div class="marquee-track flex gap-8 w-max">
      {
        [...clients, ...clients].map((client) => (
          <div class="flex-shrink-0 px-8 py-6 bg-white rounded-sm border border-bi-gray-dark min-w-[220px] flex items-center justify-center">
            <span class="text-bi-navy/70 font-bold text-sm uppercase tracking-wider text-center whitespace-nowrap">
              {client}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Static grid for smaller screens / accessibility -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 reveal">
      {
        clients.map((client) => (
          <div class="px-4 py-5 bg-white rounded-sm border border-bi-gray-dark flex items-center justify-center text-center">
            <span class="text-bi-navy/60 font-semibold text-xs uppercase tracking-wider leading-tight">
              {client}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
