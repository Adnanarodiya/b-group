---
const clients = [
  "AM/NS India",
  "Larsen & Toubro",
  "Godrej & Boyce",
  "Ministry of Defence",
  "Chowgule Group",
  "ElectroMech",
  "UNP Polyvalves",
  "Lohr India",
  "Marini Fayat Group",
  "Laxmipati Engineering",
  "NAFTech",
];
---

<section class="trusted section" id="trusted" aria-labelledby="trusted-title">
  <div class="container">
    <div class="intro reveal">
      <p class="section-label">Trusted By</p>
      <h2 class="section-title" id="trusted-title">Partners who build at scale</h2>
      <p class="section-lead">
        From defence and steel to engineering majors — organisations that demand
        reliability choose BiGROUP.
      </p>
    </div>

    <div class="logo-marquee" aria-label="Client logos">
      <div class="marquee-track">
        {
          clients.map((client) => (
            <div class="logo-chip">
              <span>{client}</span>
            </div>
          ))
        }
        {
          clients.map((client) => (
            <div class="logo-chip" aria-hidden="true">
              <span>{client}</span>
            </div>
          ))
        }
      </div>
    </div>

    <ul class="client-grid reveal">
      {
        clients.map((client) => (
          <li>
            <span>{client}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trusted {
    background: var(--white);
    overflow: hidden;
  }

  .intro {
    margin-bottom: 2rem;
  }

  .logo-marquee {
    position: relative;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    margin-bottom: 2rem;
  }

  .marquee-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .logo-chip {
    flex: 0 0 auto;
    min-width: 180px;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    background: var(--mist);
    text-align: center;
  }

  .logo-chip span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--blue);
    letter-spacing: -0.01em;
  }

  .client-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .client-grid li {
    min-height: 4.25rem;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 0.85rem;
    border-bottom: 2px solid transparent;
    background: linear-gradient(180deg, #f8fafd, #eef3fb);
    transition:
      border-color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }

  .client-grid li:hover {
    border-bottom-color: var(--gold);
    transform: translateY(-2px);
  }

  .client-grid span {
    font-weight: 700;
    color: var(--blue-deep);
    font-size: 0.92rem;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 800px) {
    .client-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .logo-marquee {
      display: none;
    }
  }

  @media (max-width: 799px) {
    .client-grid {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
    }
  }
</style>
