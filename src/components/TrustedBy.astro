---
const clients = [
  "AM/NS India",
  "Larsen & Toubro",
  "Godrej & Boyce",
  "Ministry of Defence",
  "Chowgule Group",
  "ElectroMech",
  "UNP Polyvalves",
  "Lohr India",
  "Marini Fayat Group",
  "Laxmipati Engineering",
  "NAFTech",
];
---

<section class="section" id="trusted">
  <div class="container mb-8">
    <div class="flex justify-between flex-col md:flex-row items-center gap-6">
      <div class="reveal">
        <h2 class="text-center gradient-text text-[clamp(2rem,4vw,3.2rem)] md:text-left">
          Trusted By
          <br />
          Partners Who <em>Build</em>
        </h2>
      </div>
      <div class="flex justify-center gap-3">
        <button
          class="trust-prev size-12 rounded-full bg-light card-shadow flex items-center justify-center text-xl"
          aria-label="Previous"
          type="button">←</button
        >
        <button
          class="trust-next size-12 rounded-full bg-light card-shadow flex items-center justify-center text-xl"
          aria-label="Next"
          type="button">→</button
        >
      </div>
    </div>
  </div>

  <div class="reveal swiper trust-swiper px-4">
    <div class="swiper-wrapper">
      {
        clients.map((client) => (
          <div class="swiper-slide">
            <div class="px-8 pt-10 pb-12 bg-light rounded-[28px] h-full relative overflow-hidden card-shadow min-h-56 flex flex-col justify-between">
              <div class="size-16 rounded-2xl bg-primary/10 text-primary font-semibold flex items-center justify-center text-xl">
                Bi
              </div>
              <div>
                <h3 class="text-2xl font-medium mb-2">{client}</h3>
                <p class="text-text-dark">
                  Enterprise partner highlighted in BiGROUP’s trusted network.
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation, Autoplay } from "swiper/modules";

  new Swiper(".trust-swiper", {
    modules: [Navigation, Autoplay],
    loop: true,
    autoplay: { delay: 7000, disableOnInteraction: false },
    speed: 900,
    spaceBetween: 24,
    centeredSlides: true,
    slidesPerView: 1,
    navigation: {
      nextEl: ".trust-next",
      prevEl: ".trust-prev",
    },
    breakpoints: {
      768: { slidesPerView: 1.2 },
      1262: { slidesPerView: 2.2 },
    },
  });
</script>
