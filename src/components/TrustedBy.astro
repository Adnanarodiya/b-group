---
import { clients } from "../data/site";

/** Duplicated once so the CSS marquee can loop seamlessly at -50%. */
const rowOne = [...clients, ...clients];
const rowTwo = [...[...clients].reverse(), ...[...clients].reverse()];
---

<section aria-label="Clients who trust Bi Group" class="border-y border-navy-100 bg-white py-20 lg:py-24">
  <div class="container-page">
    <div class="flex flex-col items-start gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow text-signal-600" data-reveal>Trusted by</p>
        <h2
          class="mt-4 max-w-2xl text-[clamp(1.75rem,3.4vw,2.5rem)] leading-tight font-extrabold text-navy-800"
          data-reveal
          style="--reveal-delay:60ms"
        >
          Steel majors, EPC contractors and defence buyers hold us to their standards.
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-navy-900/55" data-reveal style="--reveal-delay:120ms">
        A selection of organisations we supply across coatings, engineering and application
        services.
      </p>
    </div>
  </div>

  <div
    class="marquee-mask mt-12 space-y-4"
    data-reveal
    style="--reveal-delay:160ms"
  >
    <ul class="marquee-track flex w-max animate-marquee items-center gap-4">
      {
        rowOne.map((client) => (
          <li class="client-chip">{client}</li>
        ))
      }
    </ul>
    <ul class="marquee-track flex w-max animate-marquee-reverse items-center gap-4">
      {
        rowTwo.map((client) => (
          <li class="client-chip">{client}</li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marquee-mask {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .client-chip {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    white-space: nowrap;
    border: 1px solid var(--color-navy-100);
    border-radius: 999px;
    background: linear-gradient(180deg, white, var(--color-mist));
    padding: 0.75rem 1.375rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: color-mix(in oklab, var(--color-navy-800) 85%, white);
    transition:
      color 0.4s var(--ease-brand),
      border-color 0.4s var(--ease-brand),
      box-shadow 0.4s var(--ease-brand);
  }

  .client-chip::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-signal-500);
    flex: none;
  }

  .client-chip:hover {
    color: var(--color-navy-600);
    border-color: var(--color-navy-200);
    box-shadow: var(--shadow-card);
  }

  .marquee-mask:hover .marquee-track {
    animation-play-state: paused;
  }
</style>
