---
---

<section class="cta section" id="cta">
  <div class="container cta-band reveal">
    <div>
      <p class="section-label">Next step</p>
      <h2 class="section-title">Ready to partner with BiGROUP?</h2>
      <p class="section-lead">
        Tell us about your project, supply need, or collaboration — our team will
        connect you with the right vertical.
      </p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href="#contact">Contact BiGROUP</a>
      <a class="btn btn-ghost" href="#businesses">View verticals</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: 0;
    background: var(--mist);
  }

  .cta-band {
    display: grid;
    gap: 2rem;
    padding: clamp(2.25rem, 5vw, 3.5rem);
    background:
      linear-gradient(125deg, var(--blue-deep) 0%, var(--blue) 48%, #1347b8 100%);
    color: var(--white);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .cta-band::after {
    content: "";
    position: absolute;
    right: -4rem;
    top: -4rem;
    width: 16rem;
    height: 16rem;
    background: radial-gradient(circle, rgba(255, 193, 7, 0.28), transparent 68%);
    pointer-events: none;
  }

  .section-label {
    color: var(--gold);
  }

  .section-title,
  .section-lead {
    color: var(--white);
  }

  .section-lead {
    opacity: 0.86;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: end;
  }

  @media (min-width: 860px) {
    .cta-band {
      grid-template-columns: 1.4fr auto;
      align-items: end;
    }
  }
</style>
