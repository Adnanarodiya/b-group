---
import IconButton from "./IconButton.astro";
---

<section class="section" id="cta">
  <div class="container">
    <div
      class="reveal relative overflow-hidden rounded-[2rem] md:rounded-[3rem] px-6 py-16 md:py-20 text-center bg-[image:var(--background-image-gradient-secondary)]"
    >
      <div class="absolute inset-0 bg-primary/20"></div>
      <div class="relative z-10 flex flex-col items-center gap-5">
        <h2 class="text-light text-[clamp(2rem,4vw,3.2rem)]">
          Ready to Partner
          <br />
          With <em class="text-secondary">BiGROUP</em>?
        </h2>
        <p class="text-light/90 max-w-lg text-lg">
          Tell us about your project, supply need, or collaboration — we’ll connect you with the
          right vertical.
        </p>
        <ul class="flex flex-wrap justify-center gap-3 text-light/90 text-sm font-medium mb-2">
          <li class="bg-light/10 rounded-full px-4 py-2">No obligation enquiry</li>
          <li class="bg-light/10 rounded-full px-4 py-2">Right vertical match</li>
          <li class="bg-light/10 rounded-full px-4 py-2">Enterprise-ready support</li>
        </ul>
        <IconButton href="#contact" label="Contact BiGROUP" />
      </div>
    </div>
  </div>
</section>
