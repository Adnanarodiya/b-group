---
---

<section id="contact" class="relative py-24 lg:py-32 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-bi-navy">
    <div class="absolute inset-0 opacity-10">
      <img
        src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1920&q=80"
        alt=""
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-bi-gold/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-bi-gold/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- CTA Content -->
      <div class="reveal">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-6">
          Ready to Partner with <span class="text-bi-gold italic">Bi Group?</span>
        </h2>
        <p class="text-lg text-white/70 leading-relaxed mb-8">
          Whether you're looking for premium paints, engineering solutions, or exploring partnership opportunities — our team is here to help you succeed.
        </p>

        <div class="space-y-4">
          <div class="flex items-center gap-4 text-white/80">
            <div class="w-10 h-10 bg-bi-gold/20 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-bi-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <span>info@bigroup.in</span>
          </div>
          <div class="flex items-center gap-4 text-white/80">
            <div class="w-10 h-10 bg-bi-gold/20 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-bi-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <span>+91 1800-XXX-XXXX</span>
          </div>
          <div class="flex items-center gap-4 text-white/80">
            <div class="w-10 h-10 bg-bi-gold/20 rounded-sm flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-bi-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span>India</span>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="reveal bg-white rounded-sm p-8 lg:p-10 shadow-2xl">
        <h3 class="text-2xl font-bold text-bi-navy mb-6">Get in Touch</h3>
        <form class="space-y-5" onsubmit="return false;">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-bi-navy/70 mb-1.5">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Your name"
                class="w-full px-4 py-3 border border-bi-gray-dark rounded-sm text-bi-navy placeholder:text-bi-navy/40 focus:outline-none focus:ring-2 focus:ring-bi-gold/50 focus:border-bi-gold transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-bi-navy/70 mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@company.com"
                class="w-full px-4 py-3 border border-bi-gray-dark rounded-sm text-bi-navy placeholder:text-bi-navy/40 focus:outline-none focus:ring-2 focus:ring-bi-gold/50 focus:border-bi-gold transition-colors"
              />
            </div>
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-bi-navy/70 mb-1.5">Company</label>
            <input
              type="text"
              id="company"
              name="company"
              placeholder="Your company"
              class="w-full px-4 py-3 border border-bi-gray-dark rounded-sm text-bi-navy placeholder:text-bi-navy/40 focus:outline-none focus:ring-2 focus:ring-bi-gold/50 focus:border-bi-gold transition-colors"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-bi-navy/70 mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="How can we help you?"
              class="w-full px-4 py-3 border border-bi-gray-dark rounded-sm text-bi-navy placeholder:text-bi-navy/40 focus:outline-none focus:ring-2 focus:ring-bi-gold/50 focus:border-bi-gold transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full px-8 py-4 bg-bi-gold text-bi-navy font-bold text-sm uppercase tracking-wider rounded-sm hover:bg-bi-gold-light transition-all duration-300 hover:shadow-lg hover:shadow-bi-gold/25"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
