---
const reasons = [
  {
    title: "Proven with the toughest clients",
    text: "When the Ministry of Defence and L&T specify your products, quality is no longer a claim — it's a track record.",
    icon: `<path d="M12 2 4 5.5v5C4 16 7.4 20.4 12 22c4.6-1.6 8-6 8-11.5v-5L12 2Z" /><path d="m8.8 11.8 2.3 2.3 4.2-4.9" />`,
  },
  {
    title: "One group, end-to-end",
    text: "Manufacturing, services and distribution under one roof means fewer hand-offs, faster delivery and a single point of accountability.",
    icon: `<rect x="3" y="3" width="7.5" height="7.5" rx="1.8" /><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8" /><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8" /><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8" />`,
  },
  {
    title: "Made for Indian conditions",
    text: "Every product is engineered and tested against Indian heat, humidity, dust and usage patterns — not adapted as an afterthought.",
    icon: `<circle cx="12" cy="12" r="9" /><path d="M3.5 9.5h17" /><path d="M3.5 14.5h17" /><path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />`,
  },
  {
    title: "Sustainability built in",
    text: "Low-VOC formulations, energy-efficient appliances and responsible sourcing across every vertical — growth that doesn't cost the earth.",
    icon: `<path d="M12 21c-5 0-8-3-8-8 0-5.5 4.5-10 12-10-1 2-1 3.5 0 5.5 1.5 3 1 6-1 8.5-1 1.2-2 2-3 4Z" /><path d="M6 18c2-4 5-7 9-9" />`,
  },
  {
    title: "Value without compromise",
    text: "Group-scale procurement and Indian manufacturing let us deliver premium quality at prices that make sense.",
    icon: `<circle cx="12" cy="12" r="9" /><path d="M9 8.5h6M9 12h6m-5.5 0c2.5 0 3.5 1 1.5 3.5L14 17" />`,
  },
  {
    title: "A partner, not just a vendor",
    text: "Dedicated account teams, on-site support and service warranties — we stay involved long after the invoice.",
    icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" /><circle cx="10" cy="7" r="4" /><path d="M21 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />`,
  },
];
---

<section class="why section" id="why">
  <div class="container">
    <div class="why__head">
      <p class="eyebrow eyebrow--light" data-reveal>Why Bi Group</p>
      <h2 class="section-title" data-reveal style="--reveal-delay: 80ms">
        The advantages of thinking like a group
      </h2>
    </div>

    <div class="why__grid">
      {reasons.map((reason, i) => (
        <article class="reason" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
          <span class="reason__icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={reason.icon}
            />
          </span>
          <h3 class="reason__title">{reason.title}</h3>
          <p class="reason__text">{reason.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why {
    background: linear-gradient(165deg, var(--navy-900), var(--navy-800));
    color: #fff;
  }

  .why__head {
    margin-bottom: 3.2rem;
  }

  .why__head .section-title {
    color: #fff;
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .reason {
    padding: 2rem 1.9rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    transition: background-color 0.3s ease, transform 0.3s ease,
      border-color 0.3s ease;
  }

  .reason:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(246, 180, 14, 0.45);
    transform: translateY(-5px);
  }

  .reason__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 13px;
    background: rgba(246, 180, 14, 0.14);
    color: var(--yellow-500);
  }

  .reason__title {
    margin-top: 1.3rem;
    font-size: 1.12rem;
    font-weight: 800;
  }

  .reason__text {
    margin-top: 0.55rem;
    font-size: 0.93rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 960px) {
    .why__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
