---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=2000&q=80"
      alt=""
      width="2000"
      height="1200"
      fetchpriority="high"
    />
    <div class="hero-scrim"></div>
    <div class="hero-grain"></div>
  </div>

  <div class="hero-content">
    <p class="hero-brand reveal">BiGROUP</p>
    <h1 id="hero-title" class="reveal reveal-delay-1">
      Coatings, industry &amp; everyday solutions — under one group.
    </h1>
    <p class="hero-copy reveal reveal-delay-2">
      A diversified Indian conglomerate protecting assets, powering homes, and
      building trust across paints, engineering, and consumer verticals.
    </p>
    <div class="hero-actions reveal reveal-delay-3">
      <a class="btn btn-primary" href="#businesses">Explore businesses</a>
      <a class="btn btn-ghost" href="#contact">Talk to us</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    animation: hero-pan 18s ease-in-out infinite alternate;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgba(0, 26, 85, 0.88) 0%,
        rgba(0, 45, 136, 0.62) 42%,
        rgba(0, 20, 50, 0.45) 100%
      ),
      linear-gradient(to top, rgba(0, 18, 48, 0.78), transparent 48%);
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.22) 0.6px,
      transparent 0.6px
    );
    background-size: 3px 3px;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(100% - 2.5rem, var(--max));
    margin-inline: auto;
    padding: 8.5rem 0 4.5rem;
    max-width: 760px;
    margin-left: max(1.25rem, calc((100% - var(--max)) / 2));
  }

  .hero-brand {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 1.1rem;
  }

  .hero-brand::after {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-left: 0.18em;
    margin-bottom: 0.28em;
    vertical-align: baseline;
    background: var(--gold);
  }

  #hero-title {
    font-size: clamp(1.55rem, 3.4vw, 2.45rem);
    font-weight: 700;
    max-width: 18ch;
    color: rgba(255, 255, 255, 0.96);
  }

  .hero-copy {
    margin-top: 1.15rem;
    max-width: 38ch;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.84);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  @keyframes hero-pan {
    from {
      transform: scale(1.06) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.12) translate3d(-1.5%, -1%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media img {
      animation: none;
      transform: scale(1.04);
    }
  }
</style>
