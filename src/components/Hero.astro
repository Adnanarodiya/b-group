---
import Icon from "./Icon.astro";
import { clients, verticals } from "../data/site";

const fan = verticals.slice(0, 7);
/** Duplicated exactly once so the CSS marquee loops seamlessly at -50%. */
const heroClients = [...clients.slice(0, 6), ...clients.slice(0, 6)];
---

<section class="relative isolate overflow-hidden bg-navy-950 text-white">
  <!-- Atmosphere: brand gradient, colour glows and a fine grain overlay. -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(120%_120%_at_15%_0%,#16307f_0%,#0b1c4d_45%,#040b21_100%)]"></div>
  <div
    class="absolute -top-40 -left-32 -z-10 size-[38rem] rounded-full bg-navy-500/45 blur-[110px] animate-float-slow"
  >
  </div>
  <div
    class="absolute top-1/3 -right-24 -z-10 size-[30rem] rounded-full bg-signal-500/20 blur-[120px] animate-drift"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"
  >
  </div>
  <div class="grain -z-10"></div>

  <div class="container-page relative flex min-h-[100svh] flex-col justify-center pt-36 pb-16 lg:pt-40">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      <!-- min-w-0 keeps the nowrap client ticker from widening the grid column. -->
      <div class="min-w-0">
        <p class="eyebrow text-signal-500" data-reveal>Diversified Indian manufacturing group</p>

        <h1
          class="mt-6 text-[clamp(2.6rem,7vw,4.75rem)] leading-[0.98] font-extrabold"
          data-reveal
          style="--reveal-delay:80ms"
        >
          Ten businesses.<br />
          <span class="relative inline-block">
            <span class="relative z-10">One standard</span>
            <span class="marker absolute -inset-x-1 bottom-1 z-0 h-[0.42em] bg-signal-500/85"></span>
          </span>{" "}of quality.
        </h1>

        <p
          class="mt-7 max-w-xl text-lg leading-relaxed text-white/70"
          data-reveal
          style="--reveal-delay:160ms"
        >
          From protective coatings on a steel plant to the kitchen in a family home, Bi Group
          manufactures, applies and delivers with the same specification discipline across every
          vertical.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:240ms">
          <a href="#businesses" class="btn btn-primary">
            Explore our businesses
            <Icon name="arrow-right" class="size-4" strokeWidth={2} />
          </a>
          <a href="#contact" class="btn btn-ghost text-white">Talk to our team</a>
        </div>

        <div class="mt-14 max-w-xl" data-reveal style="--reveal-delay:320ms">
          <p class="text-[0.7rem] font-semibold tracking-[0.2em] text-white/45 uppercase">
            Specified by
          </p>
          <div class="marquee mt-4 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
            <ul class="flex w-max animate-marquee items-center gap-8">
              {
                heroClients.map((client) => (
                  <li class="font-display text-sm font-semibold whitespace-nowrap text-white/60">
                    {client}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Paint-chip fan: one swatch per vertical, lifting on hover. -->
      <div data-reveal="scale" style="--reveal-delay:220ms">
        <div class="fan-wrap relative" aria-hidden="true">
          <div class="fan">
          {
            fan.map((vertical, index) => (
              <article
                class="chip"
                style={`--i:${index};--accent:${vertical.accent};--offset:${index - (fan.length - 1) / 2}`}
              >
                <span class="chip__swatch"></span>
                <span class="chip__label">{vertical.short}</span>
                <span class="chip__code">Bi {String(1001 + index * 7)}</span>
              </article>
            ))
          }
          </div>
        </div>

        <div
          class="mt-1 w-[min(19rem,100%)] rounded-2xl border border-white/15 bg-white/8 p-5 backdrop-blur-md"
        >
          <p class="font-display text-4xl font-extrabold text-signal-500">
            <span data-count-to="10">10</span>
          </p>
          <p class="mt-1 text-sm leading-snug text-white/70">
            verticals sourced through one accountable relationship — not ten vendor contracts.
          </p>
        </div>
      </div>
    </div>

    <a
      href="#about"
      class="mt-16 inline-flex items-center gap-2 self-start text-xs font-semibold tracking-[0.2em] text-white/50 uppercase transition-colors hover:text-white"
    >
      <Icon name="arrow-down" class="size-4 animate-bounce" strokeWidth={2} />
      Scroll to discover
    </a>
  </div>
</section>

<style>
  .marker {
    transform-origin: left center;
    animation: marker-in 0.9s var(--ease-brand) 0.5s both;
  }

  @keyframes marker-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .marquee {
    overflow: hidden;
  }

  .fan-wrap {
    --chip-w: 9rem;
    height: 15.5rem;
  }

  .fan {
    position: absolute;
    inset: 0;
    /* Chips swing around a pivot well below the deck, so the fan opens wide. */
    --pivot: 16rem;
    --spread: 8deg;
  }

  .chip {
    position: absolute;
    left: 50%;
    width: var(--chip-w);
    padding: 0.75rem 0.75rem 1rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.97);
    color: var(--color-navy-900);
    box-shadow: 0 20px 45px -20px rgb(4 11 33 / 0.85);
    bottom: 2.5rem;
    transform-origin: 50% calc(100% + var(--pivot));
    transform: translateX(-50%) rotate(calc(var(--offset) * var(--spread)));
    transition:
      transform 0.6s var(--ease-brand),
      box-shadow 0.6s var(--ease-brand);
    animation: chip-in 0.9s var(--ease-brand) backwards;
    animation-delay: calc(280ms + var(--i) * 80ms);
    z-index: calc(10 - var(--i));
  }

  .chip:hover,
  .chip:focus-within {
    transform: translateX(-50%) rotate(calc(var(--offset) * var(--spread)))
      translateY(-2.25rem) scale(1.03);
    box-shadow: 0 34px 60px -22px rgb(4 11 33 / 0.95);
    z-index: 20;
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateX(-50%) rotate(0deg) translateY(3.5rem);
    }
  }

  @media (width < 40rem) {
    .fan-wrap {
      --chip-w: 7rem;
      height: 13rem;
    }
    .fan {
      --pivot: 12rem;
      --spread: 7deg;
    }
    .chip {
      bottom: 2rem;
      padding: 0.6rem 0.6rem 0.8rem;
    }
    .chip__swatch {
      height: 3.5rem;
    }
  }

  .chip__swatch {
    display: block;
    height: 4.5rem;
    border-radius: 0.625rem;
    background: linear-gradient(160deg, var(--accent), color-mix(in oklab, var(--accent) 62%, black));
  }

  /* Cards overlap like a real shade fan, so the name only shows on the card
     that has been lifted to the front. */
  .chip__label,
  .chip__code {
    display: block;
    opacity: 0;
    transition: opacity 0.4s var(--ease-brand);
  }

  .chip:hover .chip__label,
  .chip:hover .chip__code,
  .chip:focus-within .chip__label,
  .chip:focus-within .chip__code {
    opacity: 1;
  }

  .chip__label {
    margin-top: 0.625rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .chip__code {
    margin-top: 0.125rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgb(7 19 53 / 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      animation: none;
    }
    .marker {
      animation: none;
    }
  }
</style>
