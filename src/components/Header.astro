---
import IconButton from "./IconButton.astro";

const links = [
  { label: "About", href: "#about" },
  { label: "Businesses", href: "#businesses" },
  { label: "Sustainability", href: "#why" },
  { label: "Investors", href: "#cta" },
  { label: "Newsroom", href: "#flagship" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="header z-30 fixed top-6 w-full transition-all duration-700 ease-in-out"
  id="main-header"
>
  <nav class="navbar">
    <a href="#top" class="shrink-0 inline-flex" aria-label="BiGROUP home">
      <img src="/logo.svg" alt="BiGROUP" width="148" height="34" class="h-8 w-auto" />
    </a>

    <input id="nav-toggle" type="checkbox" class="peer hidden" />
    <label
      for="nav-toggle"
      class="ml-auto cursor-pointer md:hidden text-dark order-2"
      aria-label="Toggle menu"
    >
      <svg class="h-7 w-7 fill-current" viewBox="0 0 20 20">
        <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
      </svg>
    </label>

    <ul
      class="order-3 peer-checked:flex hidden w-full md:flex md:items-center md:w-auto md:flex-row flex-col gap-y-3 md:gap-x-1 absolute md:static top-[calc(100%+0.5rem)] left-4 right-4 bg-light md:bg-transparent rounded-3xl md:rounded-none p-5 md:p-0 shadow-xl md:shadow-none z-40"
    >
      {
        links.map((link, i) => (
          <li class="contents md:contents">
            {i > 0 ? (
              <span class="hidden md:inline-block bg-dark/80 size-1.5 rounded-full mx-1 self-center" />
            ) : null}
            <a href={link.href} class="nav-link block">
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="md:hidden pt-2 list-none">
        <IconButton href="#contact" label="Contact Us" class="w-full" />
      </li>
    </ul>

    <div class="hidden md:block ml-2 order-4">
      <IconButton href="#contact" label="Contact Us" />
    </div>
  </nav>
</header>

<script>
  function initHeader() {
    const header = document.getElementById("main-header");
    if (!header) return;
    let last = 0;
    const onScroll = () => {
      const y = window.scrollY;
      if (y < last || y < 24) {
        header.classList.remove("-translate-y-40", "opacity-0");
        header.classList.add("translate-y-0", "opacity-100");
      } else if (y > last && y > 24) {
        header.classList.add("-translate-y-40", "opacity-0");
        header.classList.remove("translate-y-0", "opacity-100");
      }
      last = y;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  initHeader();
</script>
