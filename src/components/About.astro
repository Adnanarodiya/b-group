---
---

<section class="about section" id="about">
  <div class="container about-grid">
    <div class="about-copy reveal">
      <p class="section-label">About Bi Group</p>
      <h2 class="section-title">One group. Many engines of growth.</h2>
      <p class="section-lead">
        BiGROUP brings together industrial coatings excellence and consumer-facing
        businesses — delivering performance where it matters and everyday value
        where people live.
      </p>
      <p class="about-body">
        From protective coatings trusted by infrastructure leaders to modular
        kitchens, agriculture, electronics, and e-commerce, we operate with a
        shared commitment to quality, reliability, and long-term partnership.
      </p>
      <a class="btn btn-outline" href="#why">Why partners choose us</a>
    </div>

    <div class="about-visual reveal reveal-delay-2" aria-hidden="true">
      <div class="about-frame">
        <img
          src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&w=1200&q=80"
          alt=""
          width="1200"
          height="900"
          loading="lazy"
        />
      </div>
      <div class="about-accent"></div>
    </div>
  </div>
</section>

<style>
  .about {
    background:
      radial-gradient(circle at 90% 10%, rgba(255, 193, 7, 0.12), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, var(--mist) 100%);
  }

  .about-grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }

  .about-body {
    margin: 1.25rem 0 2rem;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .about-visual {
    position: relative;
  }

  .about-frame {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    aspect-ratio: 5 / 4;
  }

  .about-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-accent {
    position: absolute;
    right: -0.75rem;
    bottom: -0.75rem;
    width: 42%;
    height: 42%;
    border: 3px solid var(--gold);
    z-index: -1;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 4rem;
    }
  }
</style>
