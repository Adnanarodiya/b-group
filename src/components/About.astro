---
const cards = [
  {
    title: "One Group.",
    em: "Many Engines",
    text: "BiGROUP brings industrial coatings excellence together with consumer-facing businesses across India.",
    points: [
      "Diversified vertical portfolio",
      "Industrial + consumer reach",
      "Long-term partnership mindset",
    ],
    reverse: false,
    media: "from-secondary/50 via-quinary/30 to-primary/25",
  },
  {
    title: "Quality Without",
    em: "Compromise",
    text: "Performance-first products and processes designed for demanding Indian operating conditions.",
    points: [],
    reverse: true,
    media: "from-tertiary/45 via-secondary/35 to-primary/20",
  },
  {
    title: "Trusted By",
    em: "Industry",
    text: "From defence and steel to engineering majors — organisations that demand reliability choose BiGROUP.",
    points: [
      "Enterprise project delivery",
      "Protective coating expertise",
      "Nationwide growth platform",
    ],
    reverse: false,
    media: "from-primary/30 via-quinary/35 to-secondary/40",
  },
];
---

<section class="section pt-24 md:pt-28" id="about">
  <div class="container">
    <div class="reveal">
      <h2 class="text-center gradient-text text-[clamp(2.1rem,4.4vw,3.4rem)] mb-10">
        About Bi
        <br />
        <em>Group</em>
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 xl:grid-cols-3 gap-6">
      {
        cards.map((card, i) => (
          <div
            class={`reveal reveal-delay-${(i % 3) + 1} bg-light px-8 py-8 rounded-2xl flex flex-col gap-y-12 h-full card-shadow`}
          >
            <div class={`flex flex-col gap-y-5 ${card.reverse ? "order-2" : ""}`}>
              <h3 class="gradient-text text-[clamp(1.5rem,2.5vw,2rem)]">
                {card.title}
                <br />
                <em>{card.em}</em>
              </h3>
              <p class="text-xl text-text-dark/90">{card.text}</p>
              {card.points.length > 0 && (
                <ul class="flex flex-col gap-y-3">
                  {card.points.map((point) => (
                    <li class="flex items-start gap-x-2">
                      <img
                        src="/images/icons/check.svg"
                        alt=""
                        width="16"
                        height="16"
                        class="w-4 h-4 shrink-0 mt-1"
                      />
                      <span class="font-semibold">{point}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div class={`${card.reverse ? "order-1 mb-auto" : "mt-auto"}`}>
              <div class={`h-28 rounded-2xl bg-gradient-to-br ${card.media}`} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
