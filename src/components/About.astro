---
---

<section id="about" class="py-24 lg:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Image -->
      <div class="reveal relative">
        <div class="relative rounded-sm overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80"
            alt="Bi Group team at work"
            class="w-full h-[500px] object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-bi-navy/40 to-transparent"></div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-6 -right-6 bg-bi-gold px-8 py-6 rounded-sm shadow-xl">
          <p class="text-3xl font-extrabold text-bi-navy">10+</p>
          <p class="text-sm font-semibold text-bi-navy/80">Business Verticals</p>
        </div>
      </div>

      <!-- Content -->
      <div class="reveal">
        <div class="gold-accent">
          <span class="text-bi-gold font-semibold text-sm uppercase tracking-widest">About Bi Group</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-bi-navy leading-tight mb-6">
          A Legacy of <span class="italic text-bi-gold">Innovation</span> & Excellence
        </h2>
        <p class="text-lg text-bi-navy/70 leading-relaxed mb-6">
          Bi Group is a diversified Indian conglomerate with a strong presence across paints & coatings, modular kitchens, agriculture, homeopathy, electronics, engineering, and e-commerce. Our commitment to quality, sustainability, and customer satisfaction has made us a trusted partner for industry leaders nationwide.
        </p>
        <p class="text-lg text-bi-navy/70 leading-relaxed mb-8">
          With flagship brands like Bi Paints leading the market, we continue to push boundaries — delivering products and solutions that protect, beautify, and transform lives across India and beyond.
        </p>

        <div class="grid grid-cols-2 gap-6">
          <div class="border-l-4 border-bi-gold pl-4">
            <p class="text-2xl font-extrabold text-bi-navy">25+</p>
            <p class="text-sm text-bi-navy/60 font-medium">Years of Excellence</p>
          </div>
          <div class="border-l-4 border-bi-gold pl-4">
            <p class="text-2xl font-extrabold text-bi-navy">500+</p>
            <p class="text-sm text-bi-navy/60 font-medium">Products & Solutions</p>
          </div>
          <div class="border-l-4 border-bi-gold pl-4">
            <p class="text-2xl font-extrabold text-bi-navy">11+</p>
            <p class="text-sm text-bi-navy/60 font-medium">Trusted Partners</p>
          </div>
          <div class="border-l-4 border-bi-gold pl-4">
            <p class="text-2xl font-extrabold text-bi-navy">Pan-India</p>
            <p class="text-sm text-bi-navy/60 font-medium">Distribution Network</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
