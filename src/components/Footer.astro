---
import IconButton from "./IconButton.astro";

const columns = [
  {
    title: "Company",
    links: [
      { label: "About us", href: "#about" },
      { label: "Businesses", href: "#businesses" },
      { label: "Sustainability", href: "#why" },
      { label: "Career", href: "#contact" },
    ],
  },
  {
    title: "Explore",
    links: [
      { label: "Newsroom", href: "#flagship" },
      { label: "Bi Foundation", href: "#why" },
      { label: "E-Commerce", href: "#businesses" },
      { label: "Investors", href: "#cta" },
    ],
  },
];
---

<footer class="pt-4 pb-10" id="contact">
  <div class="container">
    <div class="bg-primary text-light rounded-[2rem] md:rounded-[3.5rem] p-8 md:p-12 relative overflow-hidden">
      <div class="glow-blob -top-20 -right-16 size-64 bg-secondary/30"></div>
      <div
        class="glow-blob -bottom-24 -left-16 size-72 bg-quinary/25"
        style="animation-delay:1s"
      >
      </div>
      <div class="relative z-10">
      <div class="grid lg:grid-cols-[1.3fr_0.8fr_0.8fr_1.2fr] gap-10">
        <div>
          <img src="/logo-light.svg" alt="BiGROUP" class="h-9 w-auto" />
          <p class="mt-5 text-text-light max-w-sm">
            Diversified Indian conglomerate spanning coatings, engineering, home solutions,
            agriculture, and digital commerce.
          </p>
          <div class="mt-6 space-y-2">
            <a href="mailto:hello@bigroup.in" class="block text-secondary font-semibold"
              >hello@bigroup.in</a
            >
            <p class="text-text-light">India</p>
          </div>
        </div>

        {
          columns.map((column) => (
            <div>
              <h3 class="uppercase tracking-[0.12em] text-sm text-text-light mb-4">
                {column.title}
              </h3>
              <ul class="space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="hover:text-secondary transition-colors">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div>
          <h3 class="text-2xl mb-3">Book an Intro</h3>
          <p class="text-text-light mb-5">
            Time to get introduced and explore how BiGROUP can help.
          </p>
          <IconButton href="mailto:hello@bigroup.in" label="Contact Us" />
        </div>
      </div>

      <div
        class="mt-10 pt-6 border-t border-white/10 flex flex-wrap justify-between gap-3 text-sm text-text-light"
      >
        <p>© {new Date().getFullYear()} BiGROUP. All rights reserved.</p>
        <a href="#top" class="hover:text-secondary">Back to top ↑</a>
      </div>
      </div>
    </div>
  </div>
</footer>
