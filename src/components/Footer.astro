---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { pages, site, verticals } from "../data/site";

const year = new Date().getFullYear();
const groupPages = pages.filter((page) => page.label !== "Home");
const legal = [
  { label: "Privacy policy", href: "/privacy" },
  { label: "Terms of use", href: "/terms" },
  { label: "Cookie preferences", href: "/cookies" },
];
---

<footer class="relative isolate overflow-hidden bg-navy-950 text-white">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-signal-500/60 to-transparent"></div>
  <div class="grain -z-10"></div>

  <div class="container-page py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr_0.85fr_1fr]">
      <div>
        <Logo variant="light" class="text-3xl" />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-white/60">{site.description}</p>
        <div class="mt-7 flex flex-wrap gap-2">
          {
            site.social.map((channel) => (
              <a
                href={channel.href}
                class="rounded-full border border-white/15 px-3.5 py-1.5 text-xs font-semibold text-white/70 transition-all duration-400 hover:border-signal-500 hover:text-signal-500"
              >
                {channel.label}
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Group">
        <h2 class="font-display text-xs font-bold tracking-[0.18em] text-signal-500 uppercase">Group</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            groupPages.map((page) => (
              <li>
                <a href={page.href} class="text-white/65 transition-colors duration-300 hover:text-white">
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Businesses">
        <h2 class="font-display text-xs font-bold tracking-[0.18em] text-signal-500 uppercase">
          Businesses
        </h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            verticals.map((vertical) => (
              <li>
                <a
                  href={vertical.href}
                  class="text-white/65 transition-colors duration-300 hover:text-white"
                >
                  {vertical.short}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-display text-xs font-bold tracking-[0.18em] text-signal-500 uppercase">
          Get in touch
        </h2>
        <ul class="mt-5 space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-white/40" strokeWidth={1.8} />
            <a href={site.contact.phoneHref} class="text-white/70 transition-colors hover:text-white">
              {site.contact.phone}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-white/40" strokeWidth={1.8} />
            <a href={`mailto:${site.contact.email}`} class="text-white/70 transition-colors hover:text-white">
              {site.contact.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-white/40" strokeWidth={1.8} />
            <span class="text-white/70">{site.contact.address}</span>
          </li>
        </ul>
        <a href="/contact" class="btn btn-primary mt-7 !py-2.5 !text-sm">
          Contact Bi Group
          <Icon name="arrow-right" class="size-4" strokeWidth={2} />
        </a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col-reverse items-start justify-between gap-6 border-t border-white/12 pt-8 text-xs text-white/45 sm:flex-row sm:items-center"
    >
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          legal.map((item) => (
            <a href={item.href} class="transition-colors duration-300 hover:text-white">
              {item.label}
            </a>
          ))
        }
        <a href="#top" class="inline-flex items-center gap-1.5 font-semibold text-white/60 hover:text-white">
          Back to top
          <Icon name="arrow-down" class="size-3.5 rotate-180" strokeWidth={2} />
        </a>
      </div>
    </div>
  </div>
</footer>
