---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Company",
    links: [
      "About Us",
      "Sustainability",
      "Investors",
      "Newsroom",
      "Bi Foundation",
      "Career",
    ],
  },
  {
    heading: "Businesses",
    links: [
      "Bi Paints & Color Coating",
      "Bi Modular Kitchen",
      "Bi Agriculture",
      "Bi Homeopathy",
      "Bi Clothes",
    ],
  },
  {
    heading: "More Businesses",
    links: [
      "Bi Electronics",
      "Bi Air Conditioner",
      "Bi Painting Solutions",
      "Bi Engineering",
      "Bi E-Commerce",
    ],
  },
];

const socials = [
  {
    name: "LinkedIn",
    icon: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" />`,
  },
  {
    name: "Instagram",
    icon: `<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />`,
  },
  {
    name: "X",
    icon: `<path d="m3 3 8.4 10.2L3.6 21h2.5l6.5-6.5L18 21h3l-8.7-10.6L20 3h-2.5l-6 6L7 3H3Z" fill="currentColor" stroke="none" />`,
  },
  {
    name: "YouTube",
    icon: `<path d="M2.5 17a24 24 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49 49 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24 24 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49 49 0 0 1-16.2 0A2 2 0 0 1 2.5 17Z" /><path d="m10 15 5-3-5-3v6Z" />`,
  },
];
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a href="#top" aria-label="Bi Group — home">
        <Logo variant="light" height={38} />
      </a>
      <p class="footer__tagline">
        A diversified Indian conglomerate delivering quality across paints,
        kitchens, agriculture, healthcare, apparel, electronics and more.
      </p>
      <div class="footer__socials">
        {socials.map((social) => (
          <a href="#top" aria-label={social.name} class="footer__social">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={social.icon}
            />
          </a>
        ))}
      </div>
    </div>

    {columns.map((column) => (
      <nav class="footer__col" aria-label={column.heading}>
        <h3 class="footer__heading">{column.heading}</h3>
        <ul>
          {column.links.map((link) => (
            <li><a href="#top">{link}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="footer__col footer__contact">
      <h3 class="footer__heading">Contact</h3>
      <ul>
        <li><a href="mailto:hello@bigroup.in">hello@bigroup.in</a></li>
        <li><a href="tel:+911234567890">+91 12345 67890</a></li>
        <li class="footer__address">
          Bi Group Corporate Office,<br />
          Surat, Gujarat, India
        </li>
      </ul>
    </div>
  </div>

  <div class="footer__bar">
    <div class="container footer__bar-inner">
      <p>© {year} Bi Group. All rights reserved.</p>
      <p class="footer__legal">
        <a href="#top">Privacy Policy</a>
        <a href="#top">Terms of Use</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-900);
    color: rgba(255, 255, 255, 0.72);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 2.5rem;
    padding-block: 4.5rem 3.5rem;
  }

  .footer__brand a {
    display: inline-flex;
  }

  .footer__tagline {
    margin-top: 1.3rem;
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 34ch;
  }

  .footer__socials {
    display: flex;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.8);
    transition: background-color 0.25s ease, color 0.25s ease,
      border-color 0.25s ease, transform 0.25s ease;
  }

  .footer__social:hover {
    background: var(--yellow-500);
    border-color: var(--yellow-500);
    color: var(--navy-900);
    transform: translateY(-3px);
  }

  .footer__heading {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1.1rem;
  }

  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer__col a {
    font-size: 0.92rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s ease;
  }

  .footer__col a:hover {
    color: var(--yellow-400);
  }

  .footer__address {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.4rem;
    font-size: 0.85rem;
  }

  .footer__bar p {
    margin: 0;
  }

  .footer__legal {
    display: flex;
    gap: 1.6rem;
  }

  .footer__legal a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
  }

  .footer__legal a:hover {
    color: var(--yellow-400);
  }

  @media (max-width: 1080px) {
    .footer__top {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__bar-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
