---
---

<section class="py-24 lg:py-32 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Content -->
      <div class="reveal order-2 lg:order-1">
        <div class="gold-accent">
          <span class="text-bi-gold font-semibold text-sm uppercase tracking-widest">Flagship Brand</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-bi-navy leading-tight mb-6">
          Bi Paints — <span class="italic text-bi-gold">Coloring Tomorrow</span>
        </h2>
        <p class="text-lg text-bi-navy/70 leading-relaxed mb-6">
          Our flagship paints and coatings division delivers world-class decorative and industrial solutions. From vibrant interior finishes to heavy-duty protective coatings, Bi Paints sets the standard for quality, durability, and innovation in the Indian market.
        </p>

        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 bg-bi-gold/20 rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-bi-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </span>
            <span class="text-bi-navy/80">Premium decorative paints for homes and commercial spaces</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 bg-bi-gold/20 rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-bi-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </span>
            <span class="text-bi-navy/80">Industrial-grade protective coatings for infrastructure</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 bg-bi-gold/20 rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-bi-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </span>
            <span class="text-bi-navy/80">Eco-friendly formulations with low VOC emissions</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 bg-bi-gold/20 rounded-full flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5 text-bi-gold" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </span>
            <span class="text-bi-navy/80">Trusted by defence, infrastructure, and manufacturing giants</span>
          </li>
        </ul>

        <a
          href="#contact"
          class="inline-flex items-center px-8 py-4 bg-bi-navy text-white font-bold text-sm uppercase tracking-wider rounded-sm hover:bg-bi-navy-light transition-all duration-300"
        >
          Explore Bi Paints
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Visual -->
      <div class="reveal order-1 lg:order-2 relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="rounded-sm overflow-hidden h-48">
              <img
                src="https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=400&q=80"
                alt="Paint colors"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="rounded-sm overflow-hidden h-64 bg-bi-gold flex items-center justify-center">
              <div class="text-center p-6">
                <p class="text-5xl font-extrabold text-bi-navy mb-2">500+</p>
                <p class="text-sm font-semibold text-bi-navy/80 uppercase tracking-wider">Shade Options</p>
              </div>
            </div>
          </div>
          <div class="space-y-4 pt-8">
            <div class="rounded-sm overflow-hidden h-64">
              <img
                src="https://images.unsplash.com/photo-1562259949-e8e7689d7828?w=400&q=80"
                alt="Industrial coating application"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="rounded-sm overflow-hidden h-48">
              <img
                src="https://images.unsplash.com/photo-1565182999561-98c5b65539cc?w=400&q=80"
                alt="Modern interior with Bi Paints"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
