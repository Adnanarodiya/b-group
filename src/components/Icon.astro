---
/**
 * Inline stroke-icon set. Keeping the paths local avoids an icon dependency and
 * lets every glyph inherit `currentColor` and the surrounding font size.
 */
export type IconName =
  | "paint"
  | "kitchen"
  | "agriculture"
  | "wellness"
  | "apparel"
  | "electronics"
  | "cooling"
  | "roller"
  | "engineering"
  | "ecommerce"
  | "layers"
  | "shield"
  | "factory"
  | "sun"
  | "handshake"
  | "arrow-right"
  | "arrow-down"
  | "chevron"
  | "check"
  | "phone"
  | "mail"
  | "pin"
  | "clock"
  | "menu"
  | "close"
  | "search"
  | "globe";

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "size-6", strokeWidth = 1.6 } = Astro.props;

const paths: Record<IconName, string> = {
