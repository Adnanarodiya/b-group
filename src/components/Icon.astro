  "arrow-right": `<path d="M4.5 12h15"/><path d="m13.5 6 6 6-6 6"/>`,
  "arrow-down": `<path d="M12 4.5v15"/><path d="m6 13.5 6 6 6-6"/>`,
  chevron: `<path d="m6 9.5 6 6 6-6"/>`,
  check: `<path d="m5 12.5 4.5 4.5L19 7"/>`,
  phone: `<path d="M8 3.5H5.5A2 2 0 0 0 3.5 6c0 7.7 6.8 14.5 14.5 14.5a2 2 0 0 0 2.5-2v-2.4l-4.5-1.6-2 2a15.6 15.6 0 0 1-5.5-5.5l2-2z"/>`,
  mail: `<path d="M3.5 6.5h17v11h-17z"/><path d="m3.5 7 8.5 6 8.5-6"/>`,
